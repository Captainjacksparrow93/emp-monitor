# Example Fly.io config (fly launch --copy-config). One always-on machine + a 1 GB volume.
app = "empmonitor-api"
primary_region = "bom"

[build]
  dockerfile = "server/Dockerfile"

[env]
  PORT = "8080"
  DATA_DIR = "/data"
  FLUSH_INTERVAL_MIN = "20"

[[mounts]]
  source = "empmonitor_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"   # must stay running: it holds the write buffer + live presence
  min_machines_running = 1

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
